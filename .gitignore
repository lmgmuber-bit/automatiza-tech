# NOTA DE SEGURIDAD (hardening 2026-04-30):
# Los scripts PHP de aplicación y mantenimiento ya NO se ignoran. Deben estar
# versionados para que los fixes de seguridad viajen por git y para auditoría.
# La protección contra acceso público se hace por .htaccess (bloque AT_HARDENING)
# y por checks de capability dentro de cada archivo, no por gitignore.

# Archivos PDF/binarios en wp-content raíz
wp-content/*.pdf

# Temas por defecto de WP (no los personalizamos)
wp-content/themes/twentytwenty*/

# Artefacto de migración dentro de akismet
wp-content/plugins/akismet/all-in-one-wp-migration/

# Claude Code worktrees (local)
.claude/worktrees/

# Carpetas de respaldo / archivado (pendientes de eliminar del webroot en hardening F1)
