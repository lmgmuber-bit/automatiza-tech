# SPA fallback para Apache / Hostinger / WAMP. Funciona en cualquier subcarpeta
# (sin RewriteBase — usa rutas relativas al directorio del .htaccess).
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Las fotos legacy se sirven exclusivamente por ver.php para no exponer nombres.
  RewriteRule ^fotos/ - [F,L,NC]
  RewriteRule ^admin/config\.php$ - [F,L,NC]
  RewriteRule ^index\.html$ - [L]
  # URL bonita de invitación: /<nombre>-<token> -> invitacion.php?t=<token>
  #
  # Un solo segmento a propósito. La primera versión era /i/<nombre>/<token> y
  # rompía la página entera: invitacion.php enlaza sus assets con rutas
  # relativas, así que desde dos niveles más abajo el CSS y los videos caían en
  # el catch-all del SPA y volvían como index.html con status 200 — la
  # invitación se veía sin estilos y sin videos, y sin ningún error. A la misma
  # altura que invitacion.php, todo lo relativo sigue resolviendo igual.
  #
  # El nombre es decorativo y no se valida: quien autoriza es el token, que
  # conserva sus 128 bits. QSA es obligatorio, si no se pierden hero/capitulos/qa
  # y los botones de vista previa del admin dejan de funcionar.
  # Los enlaces antiguos con invitacion.php?t= siguen sirviendo igual.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^[a-z0-9-]{1,40}-([a-f0-9]{32}|[a-f0-9]{48})$ invitacion.php?t=$1 [L,QSA]
  # Un asset con hash que ya no existe debe dar 404, NO index.html: servir HTML
  # con status 200 donde el navegador espera JS/CSS deja la tablet corriendo una
  # versión vieja en silencio en vez de fallar visiblemente.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^assets/.*\.(js|css|woff2?)$ - [R=404,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"

  # index.html SIEMPRE se revalida. Sin esta cabecera el navegador aplica caché
  # heurística sobre Last-Modified y sigue pidiendo el bundle viejo tras un
  # deploy: la tablet queda con una versión anterior aunque el servidor ya tenga
  # la nueva. Los assets llevan hash en el nombre, así que sí se cachean fuerte.
  <FilesMatch "^index\.html$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# getUserMedia exige HTTPS en producción. La redirección debe configurarse en
# el vhost/proxy con el host canónico; nunca se construye desde HTTP_HOST aquí.
