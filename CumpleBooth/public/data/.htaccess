# Bloquea TODO acceso HTTP directo a esta carpeta (themes.json, parties.json).
# Solo debe ser leída por PHP vía filesystem (lib.php), nunca servida al navegador.

# Apache 2.4+
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>

# Apache 2.2 (fallback, ej. algunos hostings antiguos)
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
