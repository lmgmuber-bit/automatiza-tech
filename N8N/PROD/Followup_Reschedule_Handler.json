    {
      "parameters": {
        "jsCode": "const data = $('Prepare Success Data').first().json;\n\n// Limpiar teléfono\nconst phone = (data.phone || '').replace(/^\\+/, '').replace(/\\s/g, '');\n\n// Formatear fecha\nconst dateObj = new Date(data.date + 'T00:00:00');\nconst options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };\nconst formattedDate = dateObj.toLocaleDateString('es-CL', options);\n\nconst meetLink = data.meet_link || 'Te llegará por correo';\nconst fichaUrl = data.ficha_url || '';\nconst meetingType = data.meeting_type || 'seguimiento';\n\n// Construir saludo personalizado\nlet greeting = `Hola ${data.client_name}`;\nif (data.company) {\n  greeting += ` de *${data.company}*`;\n}\n\nlet messageBody = '';\nlet btnPrefix = '';\n\nif (meetingType === 'seguimiento_prospecto') {\n  // TIPO 2: Prospecto (ya tuvo demo, sin ficha/MAXTECH)\n  btnPrefix = 'btn_prospect';\n  const prospectUrl = data.prospect_timeline_url || '';\n  const prospectLine = prospectUrl ? `\\n\\n📋 *Tu Seguimiento:*\\n${prospectUrl}\\n\\n👆 Desde ahí puedes ver el historial completo de tu proceso, propuesta y reuniones.` : '';\n  messageBody = `*Reunión Reagendada* 📅\\n\\n${greeting}, tu reunión con *AutomatizaTech* ha sido reagendada.\\n\\n*Asunto:* ${data.subject}\\n*Nueva Fecha:* ${formattedDate}\\n*Nueva Hora:* ${data.time} hrs (Chile)\\n*Modalidad:* Videollamada Google Meet${prospectLine}\\n\\n📧 *Revisa tu correo*, ahí encontrarás el enlace actualizado de la reunión.\\n\\n¿Confirmas tu asistencia a la nueva fecha?`;\n} else {\n  // TIPO 3: Cliente convertido (con ficha/portal/MAXTECH)\n  btnPrefix = 'btn_followup';\n  const fichaLine = fichaUrl ? `\\n\\n📂 *Tu Portal de Cliente:*\\n${fichaUrl}\\n\\n👆 Desde tu ficha puedes:\\n• Ver todo el historial de tu proyecto\\n• Revisar reuniones, pagos y entregables\\n• Consultar con *MAXTECH* 🤖, tu agente IA especializado que tiene contexto completo de tu proyecto` : '';\n  messageBody = `*Reunión de Seguimiento Reagendada*\\n\\n${greeting}, tu reunión de seguimiento con *AutomatizaTech* ha sido reagendada.\\n\\n*Proyecto:* ${data.subject}\\n*Nueva Fecha:* ${formattedDate}\\n*Nueva Hora:* ${data.time} hrs (Chile)${fichaLine}\\n\\n📧 *Revisa tu correo*, ahí encontrarás el enlace actualizado de la reunión.\\n\\n¿Confirmas tu asistencia a la nueva fecha?`;\n}\n\nconst waPayload = {\n  messaging_product: 'whatsapp',\n  recipient_type: 'individual',\n  to: phone,\n  type: 'interactive',\n  interactive: {\n    type: 'button',\n    body: {\n      text: messageBody\n    },\n    action: {\n      buttons: [\n        {\n          type: 'reply',\n          reply: {\n            id: `${btnPrefix}_confirm_${data.meeting_id}`,\n            title: '✅ Confirmar'\n          }\n        },\n        {\n          type: 'reply',\n          reply: {\n            id: `${btnPrefix}_reschedule_${data.meeting_id}`,\n            title: '⏰ Reagendar'\n          }\n        },\n        {\n          type: 'reply',\n          reply: {\n            id: `${btnPrefix}_cancel_${data.meeting_id}`,\n            title: '❌ Cancelar'\n          }\n        }\n      ]\n    }\n  }\n};\n\nreturn {\n  json: {\n    ...data,\n    phone_clean: phone,\n    whatsappBody: JSON.stringify(waPayload)\n  }\n};"
      },
