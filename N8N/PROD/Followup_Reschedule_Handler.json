      "parameters": {
        "jsCode": "// Verificar si tiene teléfono para enviar WhatsApp\nconst data = $('Prepare Success Data').first().json;\nconst phone = (data.phone || '').replace(/^\\+/, '').replace(/\\s/g, '');\n\n// Tiene teléfono válido si tiene al menos 8 dígitos\nconst hasPhone = phone.length >= 8;\n\nif (hasPhone) {\n  return { json: { ...data, hasPhone: true } };\n} else {\n  throw new Error('No tiene teléfono válido');\n}"
