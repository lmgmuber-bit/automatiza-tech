      "parameters": {
        "jsCode": "// Normalizar datos - funciona tanto con $json.body como con $json directo\nconst input = $input.first().json;\n\n// Determinar si los datos vienen en body o directamente\nconst data = input.body || input;\n\n// Debug log\nconsole.log('Input recibido:', JSON.stringify(input));\nconsole.log('Data procesada:', JSON.stringify(data));\n\n// Extraer campos\nconst meeting_id = data.meeting_id;\nconst date = data.date;\nlet time = data.time;\nconst email = data.client_email;\nconst name = data.client_name;\n\n// Normalizar tiempo - asegurar formato HH:mm:ss\nif (time && time.length === 5) {\n  time = time + ':00';\n}\n\n// Validar campos requeridos - usar !! para convertir a boolean\nconst isValid = !!(meeting_id && date && time && email);\n\nreturn {\n  json: {\n    meeting_id: meeting_id,\n    date: date,\n    time: time,\n    email: email,\n    name: name,\n    company: data.company_name || '',\n    phone: data.phone || '',\n    subject: data.meeting_subject || 'Reunión de Seguimiento',\n    old_event_id: data.old_event_id || '',\n    ficha_url: data.ficha_url || '',\n    meeting_type: data.type || 'seguimiento',\n    prospect_timeline_url: data.prospect_timeline_url || '',\n    isValid: isValid\n  }\n};"
      },
