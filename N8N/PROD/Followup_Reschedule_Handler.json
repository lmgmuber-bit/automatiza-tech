      "parameters": {
        "jsCode": "const data = $('Prepare Success Data').first().json;\n\n// Limpiar teléfono\nconst phone = (data.phone || '').replace(/^\\+/, '').replace(/\\s/g, '');\n\n// Formatear fecha\nconst dateObj = new Date(data.date + 'T00:00:00');\nconst options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };\nconst formattedDate = dateObj.toLocaleDateString('es-CL', options);\n\nconst meetLink = data.meet_link || 'Te llegará por correo';\n\n// Construir tema con empresa/proyecto si está disponible\nconst projectName = data.company || 'Proyecto';\nconst tema = `Reunión de Seguimiento del proyecto ${projectName}`;\n\nconst messageBody = {\n  messaging_product: 'whatsapp',\n  recipient_type: 'individual',\n  to: phone,\n  type: 'interactive',\n  interactive: {\n    type: 'button',\n    body: {\n      text: `🔄 *REUNIÓN REAGENDADA*\\n━━━━━━━━━━━━━━━━━━━━\\n\\nHola ${data.client_name}, tu reunión de seguimiento ha sido reagendada exitosamente.\\n\\n📆 *Nueva Fecha:* ${formattedDate}\\n🕐 *Nueva Hora:* ${data.time} hrs (Chile)\\n📌 *Tema:* ${tema}\\n\\n🔗 *Link de acceso:*\\n${meetLink}\\n\\n━━━━━━━━━━━━━━━━━━━━\\n\\n💡 *Recordatorio:*\\n• Recibirás un recordatorio antes de la reunión\\n• Asegúrate de tener buena conexión a internet\\n• El enlace de Meet ya está configurado arriba\\n\\n━━━━━━━━━━━━━━━━━━━━\\n¿Confirmas tu asistencia a la nueva fecha?`\n    },\n    action: {\n      buttons: [\n        {\n          type: 'reply',\n          reply: {\n            id: `btn_followup_confirm_${data.meeting_id}`,\n            title: '✅ Sí, confirmo'\n          }\n        },\n        {\n          type: 'reply',\n          reply: {\n            id: `btn_followup_reschedule_${data.meeting_id}`,\n            title: '📅 Reagendar'\n          }\n        }\n      ]\n    }\n  }\n};\n\nreturn {\n  json: {\n    ...data,\n    phone_clean: phone,\n    whatsappBody: JSON.stringify(messageBody)\n  }\n};"
