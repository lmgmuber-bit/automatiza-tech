      "parameters": {
        "url": "={{ $json.event_type === 'seguimiento' ? 'https://automatizatech.cl/wp-json/automatiza-tech/v1/followup-meetings/check-event?event_id=' + encodeURIComponent($json.id) : 'https://automatizatech.cl/wp-json/automatiza-tech/v1/leads/check-event?event_id=' + encodeURIComponent($json.id) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1130,
        300
      ],
      "id": "check-event-in-db",
      "name": "Check Event Exists in DB"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.exists }}",
              "value2": false
            }
          ]
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1350,
        300
      ],
      "id": "is-orphan-check",
      "name": "Is Orphan?"
    },
    {
      "parameters": {
        "jsCode": "// Safety: No borrar eventos creados hace menos de 3 horas\n// Esto da tiempo al sistema (Scheduler) para grabar el google_event_id en la BD\nconst items = $input.all();\nconst safeItems = [];\nconst now = Date.now();\nconst THREE_HOURS_MS = 3 * 60 * 60 * 1000;\n\nfor (const item of items) {\n  const created = item.json.created;\n  const updated = item.json.updated;\n  const ref = created || updated;\n  if (ref) {\n    const eventTime = new Date(ref).getTime();\n    const ageMs = now - eventTime;\n    if (ageMs < THREE_HOURS_MS) {\n      // Evento reciente - NO borrar, puede ser legítimo aún no sincronizado\n      continue;\n    }\n  }\n  safeItems.push(item);\n}\n\nreturn safeItems;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1460,
        200
      ],
      "id": "safety-check",
      "name": "Safety Check"
    },
    {
      "parameters": {
        "operation": "delete",
        "calendar": {
          "__rl": true,
          "value": "contacto@automatizatech.cl",
          "mode": "list",
          "cachedResultName": "contacto@automatizatech.cl"
        },
        "eventId": "={{ $('Check Event Exists in DB').item.json.event_id }}",
        "options": {
          "sendUpdates": "all"
        }
      },
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.1,
      "position": [
        1570,
        200
      ],
      "id": "delete-orphan-event",
      "name": "Delete Orphan Event",
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "NrhQQuWgel9eWwzp",
          "name": "Google Calendar AutomatizaTech.cl"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v22.0/946501128543201/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "whatsAppApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', recipient_type: 'individual', to: '56974940070', type: 'text', text: { preview_url: false, body: '🧹 SYNC: Evento huérfano eliminado de Google Calendar\\n\\nTipo: ' + ($('Merge All Events').item.json.event_type === 'demo' ? 'DEMO' : 'Seguimiento') + '\\nEvento: ' + $('Merge All Events').item.json.summary + '\\nFecha: ' + ($('Merge All Events').item.json.start?.dateTime || $('Merge All Events').item.json.start?.date || 'Sin fecha').substring(0,10) + '\\n\\n(No existía en BD)' } }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1790,
        200
      ],
      "id": "notify-admin",
      "name": "Notify Admin",
      "credentials": {
        "whatsAppApi": {
          "id": "SH8OXr93p852Ll6m",
          "name": "WhatsApp Tech"
        }
      }
    }
