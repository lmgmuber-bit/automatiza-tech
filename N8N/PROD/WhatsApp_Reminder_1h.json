{
  "name": "WhatsApp Recordatorio 1h - AutomatizaTech (PROD)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [260, 300],
      "id": "cron-1h-wa",
      "name": "Cada 30 minutos"
    },
    {
      "parameters": {
        "url": "https://automatizatech.cl/wp-json/automatiza-tech/v1/leads/reminders/1h",
        "options": {
          "splitIntoItems": true
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [480, 300],
      "id": "get-leads-1h-wa",
      "name": "Get Leads 1h"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "check-has-leads",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 300],
      "id": "has-leads-1h-wa",
      "name": "Has Leads?"
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [920, 260],
      "id": "split-1h-wa",
      "name": "Process One"
    },
    {
      "parameters": {
        "amount": 2,
        "unit": "seconds"
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1140, 260],
      "id": "wait-1h-wa",
      "name": "Rate Limit"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v22.0/{{ $credentials.phoneNumberId }}/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "whatsAppBusinessCloudApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"recipient_type\": \"individual\",\n  \"to\": \"{{ $json.phone }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"preview_url\": true,\n    \"body\": \"⏰ *¡Tu cita es en 1 hora!*\\n\\nHola {{ $json.name }}, te recordamos que tu reunión con AutomatizaTech está por comenzar.\\n\\n🕐 *Hora:* {{ $json.scheduled_time }} hrs\\n📍 *Enlace de Meet:* {{ $json.meet_link ? $json.meet_link : 'Te llegó por correo' }}\\n\\n¡Nos vemos pronto! 🚀\"\n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1360, 260],
      "id": "send-wa-1h",
      "name": "Send WhatsApp 1h",
      "credentials": {
        "whatsAppBusinessCloudApi": {
          "id": "TVTLZP26kDJjR0KP",
          "name": "WhatsApp account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://automatizatech.cl/wp-json/automatiza-tech/v1/leads/update-reminder/{{ $('Process One').item.json.id }}/1h",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1580, 260],
      "id": "mark-sent-1h-wa",
      "name": "Mark 1h Sent"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [920, 420],
      "id": "no-leads-1h-wa",
      "name": "No Leads"
    }
  ],
  "connections": {
    "Cada 30 minutos": {
      "main": [
        [
          {
            "node": "Get Leads 1h",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Leads 1h": {
      "main": [
        [
          {
            "node": "Has Leads?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Leads?": {
      "main": [
        [
          {
            "node": "Process One",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Leads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process One": {
      "main": [
        [
          {
            "node": "Rate Limit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Rate Limit": {
      "main": [
        [
          {
            "node": "Send WhatsApp 1h",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send WhatsApp 1h": {
      "main": [
        [
          {
            "node": "Mark 1h Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark 1h Sent": {
      "main": [
        [
          {
            "node": "Process One",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Santiago"
  },
  "active": false
}
