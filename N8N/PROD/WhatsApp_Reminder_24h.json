{
  "name": "WhatsApp Recordatorio 24h - AutomatizaTech (PROD)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hour": 9
            },
            {
              "field": "hours",
              "hour": 14
            },
            {
              "field": "hours",
              "hour": 19
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [260, 300],
      "id": "cron-24h-wa",
      "name": "Cron 9am, 2pm y 7pm"
    },
    {
      "parameters": {
        "url": "https://automatizatech.cl/wp-json/automatiza-tech/v1/leads/reminders/24h",
        "options": {
          "splitIntoItems": true
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [480, 300],
      "id": "get-leads-24h-wa",
      "name": "Get Leads 24h"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "check-has-leads",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 300],
      "id": "has-leads-24h-wa",
      "name": "Has Leads?"
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [920, 260],
      "id": "split-24h-wa",
      "name": "Process One"
    },
    {
      "parameters": {
        "amount": 3,
        "unit": "seconds"
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1140, 260],
      "id": "wait-24h-wa",
      "name": "Rate Limit"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v22.0/{{ $credentials.phoneNumberId }}/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "whatsAppBusinessCloudApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"recipient_type\": \"individual\",\n  \"to\": \"{{ $json.phone }}\",\n  \"type\": \"interactive\",\n  \"interactive\": {\n    \"type\": \"button\",\n    \"header\": {\n      \"type\": \"text\",\n      \"text\": \"📅 Recordatorio de Cita\"\n    },\n    \"body\": {\n      \"text\": \"¡Hola {{ $json.name }}!\\n\\nTu reunión con AutomatizaTech está programada para:\\n\\n📅 *{{ $json.scheduled_date }}*\\n🕐 *{{ $json.scheduled_time }} hrs*\\n\\nPor favor confirma tu asistencia.\"\n    },\n    \"footer\": {\n      \"text\": \"Automatiza Tech\"\n    },\n    \"action\": {\n      \"buttons\": [\n        {\n          \"type\": \"reply\",\n          \"reply\": {\n            \"id\": \"btn_confirm_24h\",\n            \"title\": \"✅ Confirmo\"\n          }\n        },\n        {\n          \"type\": \"reply\",\n          \"reply\": {\n            \"id\": \"btn_decline_24h\",\n            \"title\": \"❌ No puedo\"\n          }\n        },\n        {\n          \"type\": \"reply\",\n          \"reply\": {\n            \"id\": \"btn_reschedule_24h\",\n            \"title\": \"📆 Reprogramar\"\n          }\n        }\n      ]\n    }\n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1360, 260],
      "id": "send-wa-24h",
      "name": "Send WhatsApp 24h",
      "credentials": {
        "whatsAppBusinessCloudApi": {
          "id": "TVTLZP26kDJjR0KP",
          "name": "WhatsApp account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://automatizatech.cl/wp-json/automatiza-tech/v1/leads/update-reminder/{{ $('Process One').item.json.id }}/24h",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1580, 260],
      "id": "mark-sent-24h-wa",
      "name": "Mark 24h Sent"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [920, 420],
      "id": "no-leads-24h-wa",
      "name": "No Leads"
    }
  ],
  "connections": {
    "Cron 9am, 2pm y 7pm": {
      "main": [
        [
          {
            "node": "Get Leads 24h",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Leads 24h": {
      "main": [
        [
          {
            "node": "Has Leads?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Leads?": {
      "main": [
        [
          {
            "node": "Process One",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Leads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process One": {
      "main": [
        [
          {
            "node": "Rate Limit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Rate Limit": {
      "main": [
        [
          {
            "node": "Send WhatsApp 24h",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send WhatsApp 24h": {
      "main": [
        [
          {
            "node": "Mark 24h Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark 24h Sent": {
      "main": [
        [
          {
            "node": "Process One",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Santiago"
  },
  "active": false
}
