{
  "name": "WhatsApp Recordatorio 72h - AutomatizaTech (PROD)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hour": 9
            },
            {
              "field": "hours",
              "hour": 18
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [260, 300],
      "id": "cron-72h-wa",
      "name": "Cron 9am y 6pm"
    },
    {
      "parameters": {
        "url": "https://automatizatech.cl/wp-json/automatiza-tech/v1/leads/reminders/72h",
        "options": {
          "splitIntoItems": true
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [480, 300],
      "id": "get-leads-72h-wa",
      "name": "Get Leads 72h"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "check-has-leads",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 300],
      "id": "has-leads-72h-wa",
      "name": "Has Leads?"
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [920, 260],
      "id": "split-72h-wa",
      "name": "Process One"
    },
    {
      "parameters": {
        "amount": 3,
        "unit": "seconds"
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1140, 260],
      "id": "wait-72h-wa",
      "name": "Rate Limit"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v22.0/{{ $credentials.phoneNumberId }}/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "whatsAppBusinessCloudApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"recipient_type\": \"individual\",\n  \"to\": \"{{ $json.phone }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"preview_url\": false,\n    \"body\": \"¡Hola {{ $json.name }}! 👋\\n\\nTe recordamos que tienes una cita agendada con *AutomatizaTech*:\\n\\n📅 Fecha: {{ $json.scheduled_date }}\\n🕐 Hora: {{ $json.scheduled_time }} hrs\\n\\nPor favor confirma tu asistencia respondiendo:\\n✅ *SI* - Confirmo asistencia\\n❌ *NO* - No podré asistir\\n\\n¡Te esperamos! 🚀\"\n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1360, 260],
      "id": "send-wa-72h",
      "name": "Send WhatsApp 72h",
      "credentials": {
        "whatsAppBusinessCloudApi": {
          "id": "TVTLZP26kDJjR0KP",
          "name": "WhatsApp account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://automatizatech.cl/wp-json/automatiza-tech/v1/leads/update-reminder/{{ $('Process One').item.json.id }}/72h",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1580, 260],
      "id": "mark-sent-72h-wa",
      "name": "Mark 72h Sent"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [920, 420],
      "id": "no-leads-72h-wa",
      "name": "No Leads"
    }
  ],
  "connections": {
    "Cron 9am y 6pm": {
      "main": [
        [
          {
            "node": "Get Leads 72h",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Leads 72h": {
      "main": [
        [
          {
            "node": "Has Leads?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Leads?": {
      "main": [
        [
          {
            "node": "Process One",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Leads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process One": {
      "main": [
        [
          {
            "node": "Rate Limit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Rate Limit": {
      "main": [
        [
          {
            "node": "Send WhatsApp 72h",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send WhatsApp 72h": {
      "main": [
        [
          {
            "node": "Mark 72h Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark 72h Sent": {
      "main": [
        [
          {
            "node": "Process One",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Santiago"
  },
  "active": false
}
