{
  "name": "WhatsApp Recordatorio 72h - AutomatizaTech (PROD)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [260, 300],
      "id": "cron-72h-wa",
      "name": "Cron cada 30 min"
    },
    {
      "parameters": {
        "url": "https://automatizatech.cl/wp-json/automatiza-tech/v1/leads/reminders-wa/72h",
        "options": {
          "splitIntoItems": true
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [480, 300],
      "id": "get-leads-72h-wa",
      "name": "Get Leads 72h"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "check-has-leads",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 300],
      "id": "has-leads-72h-wa",
      "name": "Has Leads?"
    },
    {
      "parameters": {
        "maxItems": 10
      },
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [920, 260],
      "id": "limit-72h-wa",
      "name": "Limit 10 Anti-Spam"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const data = item.json;\n  \n  // Limpiar el + del teléfono para la API de WhatsApp\n  const phone = (data.phone || '').replace(/^\\+/, '');\n  \n  const messageBody = {\n    messaging_product: 'whatsapp',\n    recipient_type: 'individual',\n    to: phone,\n    type: 'interactive',\n    interactive: {\n      type: 'button',\n      body: {\n        text: `👋 *¡Hola ${data.name}!*\\n\\nTe recordamos que tienes una cita agendada con AutomatizaTech en 3 días.\\n\\n📆 *Fecha:* ${data.scheduled_date}\\n🕐 *Hora:* ${data.scheduled_time} hrs\\n\\n¿Podrás asistir? Por favor confirma para reservar tu espacio.`\n      },\n      action: {\n        buttons: [\n          {\n            type: 'reply',\n            reply: {\n              id: `btn_reminder_confirm_${data.id}`,\n              title: '✅ Sí, confirmo'\n            }\n          },\n          {\n            type: 'reply',\n            reply: {\n              id: `btn_reminder_no_${data.id}`,\n              title: '❌ No podré'\n            }\n          }\n        ]\n      }\n    }\n  };\n  \n  results.push({\n    json: {\n      ...data,\n      whatsappBody: JSON.stringify(messageBody)\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1140, 260],
      "id": "build-body-72h-wa",
      "name": "Build WhatsApp Body"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v22.0/946501128543201/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "whatsAppApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.whatsappBody }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1360, 260],
      "id": "send-wa-72h",
      "name": "Send WhatsApp 72h",
      "credentials": {
        "whatsAppApi": {
          "id": "SH8OXr93p852Ll6m",
          "name": "WhatsApp Tech"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://automatizatech.cl/wp-json/automatiza-tech/v1/leads/update-reminder-wa/{{ $('Build WhatsApp Body').item.json.id }}/72h",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1580, 260],
      "id": "mark-sent-72h-wa",
      "name": "Mark 72h Sent"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [920, 420],
      "id": "no-leads-72h-wa",
      "name": "No Leads"
    }
  ],
  "connections": {
    "Cron cada 30 min": {
      "main": [
        [
          {
