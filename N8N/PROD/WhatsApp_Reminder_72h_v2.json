            "index": 0
          }
        ],
        [
          {
            "node": "No Leads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Limit 10 Anti-Spam": {
      "main": [
        [
          {
            "node": "Build WhatsApp Body",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build WhatsApp Body": {
      "main": [
        [
          {
            "node": "Send WhatsApp 72h",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send WhatsApp 72h": {
      "main": [
        [
          {
            "node": "Mark 72h Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Santiago"
  },
  "active": false
}
