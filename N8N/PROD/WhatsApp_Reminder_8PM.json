    {
      "parameters": {
        "jsCode": "// Preparar datos para envío de WhatsApp\nconst meeting = $input.first().json;\n\n// Limpiar teléfono\nconst phone = (meeting.phone || '').replace(/^\\+/, '');\n\n// Información personalizada\nconst clientName = meeting.name || 'Cliente';\nconst companyName = meeting.company_name || '';\nconst projectInfo = meeting.meeting_subject || 'Reunión de Seguimiento';\n\n// Construir saludo personalizado\nlet greeting = `Hola ${clientName}`;\nif (companyName) {\n  greeting += ` de *${companyName}*`;\n}\n\n// Construir mensaje\nconst messageBody = `📅 *Recordatorio - Tu reunión de seguimiento es mañana*\\n\\n${greeting}, te recordamos tu próxima reunión con AutomatizaTech.\\n\\n📋 *Proyecto:* ${projectInfo}\\n📅 *Fecha:* ${meeting.scheduled_date}\\n🕐 *Hora:* ${meeting.scheduled_time} hrs\\n📍 *Enlace:* ${meeting.meet_link || 'Te llegará por correo'}\\n\\n💡 *Recordatorio:*\\n•Recibirás otro recordatorio el día de la reunión\\n•Asegúrate de tener buena conexión a internet\\n•El enlace de Meet ya está configurado arriba\\n\\n¿Podrás asistir mañana?`;\n\nreturn {\n  json: {\n    meeting_id: meeting.id,\n    phone: phone,\n    clientName: clientName,\n    companyName: companyName,\n    projectInfo: projectInfo,\n    messageBody: messageBody,\n    btnConfirmId: `btn_followup_confirm_${meeting.id}`,\n    btnRescheduleId: `btn_followup_reschedule_${meeting.id}`,\n    btnCancelId: `btn_followup_cancel_${meeting.id}`\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        992,
        112
      ],
      "id": "3fad9aa4-51f1-4384-9e6b-289b0d12d893",
      "name": "Prepare WA Data"
    },
