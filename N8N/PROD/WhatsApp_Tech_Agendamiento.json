              "output": 2
            },
            {
              "value2": "get_slots",
              "output": 3
            }
          ]
        },
        "fallbackOutput": 4
      },
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [-600, 300],
      "id": "wa-appointment-action",
      "name": "Appointment Action"
    },
    {
      "parameters": {
        "resource": "event",
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "value": "primary",
          "mode": "list"
        },
        "returnAll": false,
        "limit": 20,
        "options": {
          "singleEvents": true
        }
      },
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.1,
      "position": [-400, 600],
      "id": "wa-get-events",
      "name": "Get Calendar Events",
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "YOUR_GOOGLE_CALENDAR_CREDENTIAL_ID",
          "name": "Google Calendar"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Generar slots disponibles (9 AM - 6 PM, Lun-Vie)\nconst existingEvents = $input.all();\nconst occupiedSlots = new Set();\n\n// Mapear eventos existentes\nexistingEvents.forEach(event => {\n  if (event.json.start && event.json.start.dateTime) {\n    occupiedSlots.add(event.json.start.dateTime.substring(0, 16));\n  }\n});\n\nconst availableSlots = [];\nconst now = new Date();\n\n// Generar slots para los próximos 14 días\nfor (let day = 1; day <= 14; day++) {\n  const date = new Date(now);\n  date.setDate(date.getDate() + day);\n  \n  // Solo Lunes a Viernes (0 = Domingo, 6 = Sábado)\n  const dayOfWeek = date.getDay();\n  if (dayOfWeek === 0 || dayOfWeek === 6) continue;\n  \n  // Horarios disponibles: 9:00, 10:00, 11:00, 14:00, 15:00, 16:00, 17:00\n  const hours = [9, 10, 11, 14, 15, 16, 17];\n  \n  for (const hour of hours) {\n    const slotDate = new Date(date);\n    slotDate.setHours(hour, 0, 0, 0);\n    \n    const slotKey = slotDate.toISOString().substring(0, 16);\n    \n    if (!occupiedSlots.has(slotKey)) {\n      const dias = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];\n      const meses = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];\n      \n      availableSlots.push({\n        date: slotDate.toISOString().split('T')[0],\n        time: hour + ':00',\n        datetime: slotDate.toISOString(),\n        displayDate: dias[slotDate.getDay()] + ' ' + slotDate.getDate() + ' de ' + meses[slotDate.getMonth()],\n        displayTime: hour + ':00 hrs'\n      });\n    }\n  }\n}\n\n// Limitar a los próximos 10 slots disponibles\nreturn availableSlots.slice(0, 10).map(slot => ({ json: slot }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [-200, 600],
      "id": "wa-generate-slots",
      "name": "Generate Available Slots"
    },
    {
      "parameters": {
        "resource": "event",
        "operation": "create",
        "calendar": {
          "__rl": true,
          "value": "primary",
          "mode": "list"
        },
        "start": "={{ $json.body.datetime }}",
        "end": "={{ new Date(new Date($json.body.datetime).getTime() + 30*60000).toISOString() }}",
        "additionalFields": {
          "summary": "=Demo AutomatizaTech - {{ $json.body.contactName }}",
          "description": "=Teléfono WhatsApp: {{ $json.body.phoneNumber }}\nNombre: {{ $json.body.contactName }}\nTipo: Demo de servicios\n\nAgendado automáticamente vía WhatsApp Bot."
        }
      },
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.1,
      "position": [-400, 100],
      "id": "wa-create-event",
      "name": "Create Calendar Event",
