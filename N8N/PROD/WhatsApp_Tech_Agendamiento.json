        "url": "=https://graph.facebook.com/v18.0/{{ $node['Appointments Webhook'].json.body.phoneNumberId }}/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "whatsAppBusinessCloudApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $node['Appointments Webhook'].json.body.phoneNumber }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"✅ ¡Tu demo ha sido agendada!\\n\\n📅 Fecha: {{ $node['Appointments Webhook'].json.body.displayDate }}\\n🕐 Hora: {{ $node['Appointments Webhook'].json.body.displayTime }}\\n\\nTe enviaremos un recordatorio 24 horas antes. ¡Nos vemos! 🚀\"\n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [0, 100],
      "id": "wa-confirm-appointment",
      "name": "Send Confirmation",
      "credentials": {
        "whatsAppBusinessCloudApi": {
          "id": "YOUR_WHATSAPP_CREDENTIAL_ID",
          "name": "WhatsApp Business Cloud API"
        }
