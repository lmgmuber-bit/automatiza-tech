    },
    {
      "parameters": {
        "jsCode": "// Formatear slots para mensaje de WhatsApp\nconst slots = $input.all();\n\nlet slotsText = '📅 *Horarios disponibles:*\\n\\n';\n\nslots.forEach((slot, index) => {\n  slotsText += (index + 1) + '. ' + slot.json.displayDate + ' a las ' + slot.json.displayTime + '\\n';\n});\n\nslotsText += '\\nResponde con el número del horario que prefieras.';\n\nconst phoneNumber = $node['Appointments Webhook'].json.body.phoneNumber;\nconst phoneNumberId = $node['Appointments Webhook'].json.body.phoneNumberId;\n\nreturn {\n  json: {\n    slotsMessage: slotsText,\n    slots: slots.map(s => s.json),\n    phoneNumber: phoneNumber,\n    phoneNumberId: phoneNumberId\n  }\n};"
      },
