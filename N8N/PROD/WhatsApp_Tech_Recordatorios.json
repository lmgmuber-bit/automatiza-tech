        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.Telefono }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"¡Hola {{ $json.Nombre }}! ⏰\\n\\nTu cita con AutomatizaTech es en 1 hora.\\n\\n¡Nos vemos pronto! 🚀\"\n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
