    {
      "parameters": {
        "jsCode": "// Obtener datos del contexto\nconst promptData = $('Obtener Prompt de BD').first().json;\nconst agentOutput = $('Agente IA - DEMO').first().json;\nconst chatInput = $('When chat message received').first().json;\nconst historyData = $('Obtener Historial MySQL').first().json;\n\n// Limpiar la respuesta (quitar el marcador)\nlet cleanOutput = agentOutput.output || '';\ncleanOutput = cleanOutput.replace('[CONVERSACION_FINALIZADA]', '').trim();\n\n// Obtener historial HTML de la API MySQL\nlet historialHTML = historyData.historial_html || '';\n\n// Si no hay historial, usar mensaje actual\nif (!historialHTML || historialHTML.trim() === '') {\n  historialHTML = `\n<div style=\"background: linear-gradient(135deg, #1e40af, #3b82f6); color: white; padding: 12px 16px; border-radius: 12px; margin: 10px 0 10px 20%; text-align: right;\">\n  <strong>👤 Usuario:</strong> ${chatInput.chatInput || 'N/A'}\n</div>\n<div style=\"background: white; border: 1px solid #e0e0e0; padding: 12px 16px; border-radius: 12px; margin: 10px 20% 10px 0;\">\n  <strong style=\"color: #06d6a0;\">🤖 Asistente:</strong> ${cleanOutput}\n</div>`;\n}\n\nreturn {\n  client_email: promptData.data?.client_email || '',\n  company_name: promptData.data?.company_name || 'Cliente',\n  session_id: chatInput.sessionId || '',\n  historial_html: historialHTML,\n  message_count: historyData.message_count || 0,\n  clean_output: cleanOutput,\n  output: cleanOutput,\n  fecha: new Date().toLocaleDateString('es-CL', { \n    day: '2-digit', \n    month: '2-digit', \n    year: 'numeric',\n    hour: '2-digit',\n    minute: '2-digit'\n  })\n};"
      },
