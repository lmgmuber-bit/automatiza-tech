    {
      "id": "c3",
      "name": "¿Hay comentario?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c3-c",
              "leftValue": "={{ String($json.ultimo_comentario || '').trim().length > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "c4",
      "name": "Aplicar comentarios",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        660,
        -120
      ],
      "parameters": {
        "resource": "chat",
        "model": "gpt-4o",
        "prompt": {
          "messages": [
            {
              "role": "system",
              "content": "Recibes el JSON de una propuesta comercial y los comentarios del consultor. Devuelve SOLO el JSON completo (sin texto antes ni después, sin bloques de código) con SOLO los cambios que piden los comentarios; todo lo demás queda idéntico, con la misma forma y claves. No toques pricing_rows, pricing_note ni unique_id (se descartan igual). Mantén español de Chile y el mismo tratamiento (tú/usted). Si un comentario pide cambiar precios, ignóralo: los precios se editan en el panel. Si pide una lámina extra nueva, agrégala en extra_slides (máximo 2) y su image_brief extra_N con el mismo cierre de prohibiciones que las demás."
            },
            {
              "content": "={{ JSON.stringify({ comentarios: $json.ultimo_comentario, propuesta: $json.payload }) }}"
            }
          ]
        },
        "options": {
          "temperature": 0.2
        },
        "requestOptions": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "g52IEXpRfN5r7jKw",
          "name": "OpenAi account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "c5",
      "name": "Payload final",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "// Une las dos ramas: con comentario (lo aplicó el modelo) o sin comentario (solo cambiaron precios).\n// Nunca lanza: si algo no cuadra devuelve ok=false con el motivo, para marcar la propuesta en error.\nconst estado = $('Leer estado').first().json;\nlet p = estado.payload;\nlet reason = '';\nif ($('Aplicar comentarios').isExecuted) {\n  const ia = $('Aplicar comentarios').first().json;\n  let c = ia && ia.message ? ia.message.content : null;\n  if (!c) {\n    reason = 'El modelo no respondió al aplicar los comentarios' + (ia && ia.error ? ': ' + (ia.error.message || ia.error) : '');\n  } else {\n    try {\n      if (typeof c === 'string') c = c.trim().replace(/^```(?:json)?\\s*/i, '').replace(/```\\s*$/, '');\n      p = typeof c === 'string' ? JSON.parse(c) : c;\n    } catch (e) {\n      reason = 'El modelo devolvió un JSON inválido al aplicar los comentarios';\n    }\n  }\n}\nif (!reason && (!p || typeof p !== 'object')) reason = 'La propuesta no tiene un payload legible';\nif (!reason) p.extra_slides = (p.extra_slides || []).slice(0, 2);\n// WordPress restaura precios y unique_id de todos modos; aquí solo se asegura el formato.\nreturn [{ json: { ok: !reason, reason, id: estado.id, unique_id: estado.unique_id, company: estado.company_name, payload: p } }];"
      }
    },
    {
      "id": "c6",
      "name": "¿Payload OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c6-c",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "c7",
