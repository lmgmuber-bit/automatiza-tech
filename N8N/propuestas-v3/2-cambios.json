        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'borrador', note: '', payload: $json.payload }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "1NI0sJKc0kC430pb",
          "name": "AT REST Secret (header)"
        }
      }
    },
