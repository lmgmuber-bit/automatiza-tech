      ],
      "parameters": {
        "fromEmail": "contacto@automatizatech.cl",
        "toEmail": "lmgm.0303@gmail.com",
        "subject": "={{ ($('Vista previa').item.json.view_url ? '' : '⚠️ ') + $('Payload final').item.json.company + ' · cambios aplicados' }}",
        "html": "=<h3>{{ $('Vista previa').item.json.view_url ? '' : '⚠️ ' }}Cambios aplicados: {{ $('Payload final').item.json.company }}</h3>\n<p>Último comentario: <em>{{ $('Leer estado').item.json.ultimo_comentario || '(sin comentario: solo precios)' }}</em></p>\n{{ $('Vista previa').item.json.view_url ? '' : '<p style=\"color:#b45309\"><strong>La nueva vista previa no se pudo generar.</strong> Los cambios quedaron guardados; «Pedir cambios» sin comentario la vuelve a generar.</p>' }}\n<p><a href=\"https://automatizatech.cl/ver-presentacion.php?id={{ $('Payload final').item.json.unique_id }}\">👀 Ver la nueva vista previa (sin fotos)</a></p>\n<p><a href=\"https://automatizatech.cl/wp-admin/admin.php?page=automatiza-proposals&edit_id={{ $('Payload final').item.json.id }}\">✏️ Seguir revisando o aprobar en el panel</a></p>\n<p style=\"color:#666\">No se ha gastado nada en fotos. Nada se envía al cliente desde este flujo.</p>",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "dyhVFWmjRNC45ccA",
          "name": "SMTP account PROD"
        }
      }
    },
    {
      "id": "c11",
      "name": "Motivo del error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        120
      ],
      "parameters": {
        "jsCode": "// Motivo legible para status_note, venga de donde venga el fallo.\nconst base = $('Payload final').first().json;\nlet reason = base.reason;\nif (!reason && $('Guardar y volver a borrador').isExecuted) {\n  const g = $('Guardar y volver a borrador').first().json;\n  const msg = g.body && (g.body.message || g.body.code) ? ' — ' + (g.body.message || g.body.code) : '';\n  reason = `WordPress rechazó el cambio (HTTP ${g.statusCode})${msg}`;\n}\nreturn [{ json: { id: base.id, unique_id: base.unique_id, company: base.company, reason: reason || 'Error desconocido al aplicar los cambios', exec: $execution.id } }];"
      }
    },
