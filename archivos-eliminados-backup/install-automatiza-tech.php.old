/**
 * Configurar SEO básico
 */
function setup_basic_seo() {
    // Configurar meta tags básicos
    update_option('meta_description', 'Automatiza Tech - Conectamos tus ventas, web y CRM. Bots inteligentes para negocios que no se detienen. Automatiza tu atención al cliente 24/7.');
    update_option('meta_keywords', 'automatización, chatbots, CRM, ventas, WhatsApp, Instagram, atención al cliente');
    
    echo "🔍 SEO básico configurado\n";
}

/**
 * Verificar requisitos del sistema
 */
function check_system_requirements() {
    $requirements = array(
        'PHP version >= 7.4' => version_compare(PHP_VERSION, '7.4.0', '>='),
        'MySQL extension' => extension_loaded('mysql') || extension_loaded('mysqli'),
        'GD extension' => extension_loaded('gd'),
        'cURL extension' => extension_loaded('curl'),
        'mbstring extension' => extension_loaded('mbstring'),
        'Writable uploads directory' => is_writable(wp_upload_dir()['basedir'])
    );
    
    $all_good = true;
    echo "\n🔍 Verificando requisitos del sistema:\n";
    
    foreach ($requirements as $requirement => $status) {
        $icon = $status ? '✅' : '❌';
        echo "$icon $requirement\n";
        if (!$status) $all_good = false;
    }
    
    if (!$all_good) {
        echo "\n⚠️ Algunos requisitos no se cumplen. Por favor, contacta a tu proveedor de hosting.\n";
        return false;
    }
    
    echo "\n✅ Todos los requisitos del sistema se cumplen.\n";
    return true;
}

// Ejecutar instalación
echo "🚀 Iniciando configuración de Automatiza Tech...\n\n";

if (check_system_requirements()) {
    automatiza_tech_initial_setup();
    echo "\n🎉 ¡Instalación completada exitosamente!\n";
    echo "🌐 Visita tu sitio web para ver el resultado.\n";
    echo "⚙️ Puedes personalizar más opciones desde el Personalizador de WordPress.\n\n";
} else {
    echo "\n❌ La instalación no se pudo completar debido a requisitos faltantes.\n";
}
