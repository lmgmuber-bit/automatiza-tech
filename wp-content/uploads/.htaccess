# Negar ejecucion de cualquier script en wp-content/uploads
# Defense-in-depth: si alguien logra subir un .php aqui, no podra ejecutarlo.
<FilesMatch "\.(php|phtml|phar|php3|php4|php5|php7|php8|pl|py|jsp|asp|sh|cgi)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Forzar Content-Type seguro para descargas
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
